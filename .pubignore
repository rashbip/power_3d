# Avoid publishing log files and temporary analysis files
analysis.txt
check.txt
required_packages_till_now.md
.gemini/
brain/
*.log

# Build artifacts and caches (root-level)
build/
.dart_tool/
.packages
.pub-cache/
.pub/

# Android build artifacts
android/app/build/
android/.gradle/
*.apk
*.aab

# iOS build artifacts
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/App.framework
ios/Flutter/App.podspec

# macOS build artifacts
macos/Flutter/ephemeral/
macos/Runner/Logs/

# Windows build artifacts
windows/flutter/ephemeral/
windows/CMakeCache.txt
windows/CMakeFiles/
windows/CMakeSettings.json
windows/cmake_install.cmake
windows/x64/

# Linux build artifacts
linux/flutter/ephemeral/

# Web build artifacts
web/stack_trace_mapper.js
web/main.dart.js
web/main.dart.js.map
web/main.dart.js.tar.gz

# Example project artifacts
example/build/
example/.dart_tool/
example/.packages
example/assets/**/*.glb
example/windows/flutter/ephemeral/
example/linux/flutter/ephemeral/
example/macos/Flutter/ephemeral/
example/web/stack_trace_mapper.js
example/web/main.dart.js

# User-requested specific ignores
stripped_native_libs/
local-state/
outputs/
tmp/
*.dill

# Annotation tool (not part of the Dart package)
babylon_annotator/

# Exclude doc markdown files but KEEP doc/screenshots for pub.dev gallery
doc/*.md

# Dev assets (not part of published package)
assets/dev/